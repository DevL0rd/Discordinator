{
  "name": "dotbot",
  "version": "2.0.0",
  "private": true,
  "description": "A headless Discord bot bridge for authenticated MCP clients.",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/src/main.js",
    "check": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "validate:connection": "tsx scripts/validate.ts --connection",
    "validate:banner": "tsx scripts/check-banner.ts",
    "complexity": "eslint src scripts",
    "lint": "eslint src scripts",
    "check:length": "tsx scripts/check-quality.ts",
    "check:spelling": "typos",
    "check:duplicates": "jscpd --fail-on-empty src scripts eslint.config.js",
    "check:format": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" eslint.config.js",
    "check:unused": "knip",
    "quality": "npm run check:length && npm run lint && npm run check:spelling && npm run check:duplicates && npm run check:format && npm run check:unused && npm run check",
    "setup:spelling": "npm rebuild @ocular-d/typos-bin --ignore-scripts=false"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "discord.js": "14.27.0",
    "file-type": "^22.1.1",
    "image-size": "^2.0.4",
    "ipaddr.js": "^2.5.0",
    "jose": "6.2.12",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "^2.2.0",
    "@ocular-d/typos-bin": "1.50.3",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "playwright-core": "^1.63.0",
    "prettier": "3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "typos-bin": {
    "version": "1.50.3"
  },
  "allowScripts": {
    "@ocular-d/typos-bin@1.50.3": true
  }
}
